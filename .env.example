# Octotally environment — copy to `.env`. Only bootstrap values and secrets live here;
# everything tunable (poll interval, active window, digest, theme…) is edited in the app's Settings page.

# GitHub token (required). Read-only access is enough — Octotally never writes to GitHub.
#
# Fine-grained PAT (recommended): GitHub → Settings → Developer settings → Personal access tokens →
#   Fine-grained tokens → Generate new token.
#   Repository access: "All repositories" (or pick the repositories you want tracked).
#   Repository permissions, all read-only: Issues, Pull requests, Discussions, Metadata.
#   Note that a fine-grained token only sees repositories of the owner/organisations you grant it;
#   for involvement across many organisations a classic token is simpler.
# Classic PAT: scopes `repo` (or `public_repo` for public repositories only) + `read:discussion`.
GITHUB_TOKEN=

# Optional single password gating the UI (login form + signed session cookie).
# Leave empty when a reverse proxy (Authelia, Cloudflare Access, Authentik…) already authenticates users.
AUTH_PASSWORD=

# Random secret signing the session cookie. Required when AUTH_PASSWORD is set, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Optional bearer token for machine clients: `Authorization: Bearer <API_TOKEN>` on /api/*.
# When set, API requests without it are rejected (fail closed).
API_TOKEN=

# Log verbosity: trace | debug | info | warn | error | fatal | silent (default info). JSON lines on stdout.
LOG_LEVEL=info

# Listen port and data directory. The image sets PORT=3000 and DATA_DIR=/data; only override for a
# local (non-Docker) run.
#PORT=3000
#DATA_DIR=./data

# Directory of the built SPA. The image sets it; locally it defaults to packages/web/dist.
#WEB_DIST=
